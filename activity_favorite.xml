<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    tools:context=".FavoriteActivity">

    <!-- Back Arrow -->
    <ImageView
        android:id="@+id/back_arrow"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:contentDescription="Back Button"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/colorBackgroundLight" />

    <!-- Title -->
    <TextView
        android:id="@+id/title_favorites"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_favorites"
        android:textColor="@color/colorBackgroundLight"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@+id/back_arrow"
        app:layout_constraintBottom_toBottomOf="@+id/back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Profile Icon -->
    <ImageView
        android:id="@+id/notification_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="Profile Icon"
        android:src="@drawable/ic_person"
        app:layout_constraintTop_toTopOf="@+id/back_arrow"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/colorBackgroundLight" />

    <!-- Favorite Icon -->
    <ImageView
        android:id="@+id/heart_icon_filled"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="Favorites Icon"
        android:src="@drawable/ic_heart_filled"
        app:layout_constraintTop_toTopOf="@+id/notification_icon"
        app:layout_constraintBottom_toBottomOf="@+id/notification_icon"
        app:layout_constraintEnd_toStartOf="@+id/notification_icon"
        app:tint="@color/colorBackgroundLight" />

    <!-- Content Scroll -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/title_favorites"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/greeting_favorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/greeting_fav"
                android:textColor="@color/colorBackgroundLight"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/chef_image"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/chef_illustration" />

            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginStart="48dp"
                android:layout_marginEnd="48dp"
                android:background="@color/colorBackgroundLight" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_favorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:padding="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/colorPrimaryDark"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="12dp"
            android:src="@drawable/ic_home"
            app:tint="@color/colorBackgroundLight" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="12dp"
            android:src="@drawable/ic_globe"
            app:tint="@color/colorBackgroundLight" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="12dp"
            android:src="@drawable/ic_location"
            app:tint="@color/colorBackgroundLight" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
