<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    tools:context=".SelectLanguageActivity">

    <ImageView
        android:id="@+id/back_button8"
        android:layout_width="40dp"
        android:layout_height="30dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:contentDescription="Back Button"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/colorBackgroundLight" />

    <ImageView
        android:id="@+id/flag_icon"
        android:layout_width="40dp"
        android:layout_height="30dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="Indonesian Flag"
        android:scaleType="fitCenter"
        android:src="@drawable/english_flag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/app_logo"
        android:layout_width="256dp"
        android:layout_height="246dp"
        android:contentDescription="Dapurku App Logo"
        android:src="@drawable/dapurku_logo"
        app:layout_constraintBottom_toTopOf="@+id/language_buttons_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/language_buttons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="120dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/english_button"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@color/colorPrimaryDark"
            android:text="English"
            android:textAllCaps="false"
            android:textColor="@color/colorBackgroundLight"
            android:textSize="20sp"
            app:cornerRadius="15dp" />

        <Button
            android:id="@+id/indonesia_button"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:backgroundTint="@color/colorPrimaryDark"
            android:text="Indonesia"
            android:textAllCaps="false"
            android:textColor="@color/colorBackgroundLight"
            android:textSize="20sp"
            app:cornerRadius="15dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>