<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    tools:context=".WelcomeActivity">

  <ImageView
      android:id="@+id/back_button10"
      android:layout_width="40dp"
      android:layout_height="30dp"
      android:layout_marginStart="24dp"
      android:layout_marginTop="32dp"
      android:contentDescription="@string/desc_back_button"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_arrow_back"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:tint="@color/colorBackgroundLight" />

  <ImageView
      android:id="@+id/flag_icon"
      android:layout_width="45dp"
      android:layout_height="30dp"
      android:layout_marginTop="32dp"
      android:layout_marginEnd="24dp"
      android:contentDescription="@string/desc_flag"
      android:scaleType="fitCenter"
      android:src="@drawable/english_flag"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <ImageView
      android:id="@+id/app_logo_circle"
      android:layout_width="180dp"
      android:layout_height="180dp"
      android:layout_marginTop="100dp"
      android:contentDescription="@string/desc_app_logo"
      android:padding="5dp"
      android:src="@drawable/dapurku_logo"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <ImageView
      android:id="@+id/chef_illustration"
      android:layout_width="208dp"
      android:layout_height="172dp"
      android:layout_marginTop="40dp"
      android:contentDescription="Cute Chef Illustration"
      android:src="@drawable/chef_illustration"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/app_logo_circle" />

  <TextView
      android:id="@+id/text_main"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="40dp"
      android:gravity="center"
      android:paddingStart="40dp"
      android:paddingEnd="40dp"
      android:text="@string/welcome_quote"
      android:textColor="@color/colorBackgroundLight"
      android:textSize="22sp"
      android:textStyle="italic"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/chef_illustration" />

  <Button
      android:id="@+id/btn_start_welcome"
      android:layout_width="168dp"
      android:layout_height="46dp"
      android:layout_marginBottom="76dp"
      android:backgroundTint="@color/colorPrimaryDark"
      android:text="@string/btn_start"
      android:textAllCaps="false"
      android:textColor="@color/colorBackgroundLight"
      android:textSize="20sp"
      app:cornerRadius="15dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />

  <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="40dp"
      android:text="@string/footer_ready"
      android:textColor="#C79685"
      android:textSize="14sp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
